# NERV 代码格式配置.
# 依据: AGENTS.md 第 7 节代码风格.
# 用法: clang-format -i <文件路径>
# 已用 clang-format 18.1.8, 23.1.0 与 23.1.3 验证.
---
Language: Cpp
BasedOnStyle: LLVM

# 缩进: 4 个空格, 禁止 Tab.
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4

# 大括号独占一行, extern 块除外.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

# extern "C" 块内容不缩进, 与 AGENTS.md 第 15.1 节的骨架一致.
IndentExternBlock: false

# 函数体, 控制语句, 分支与枚举都不合并到一行.
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# 初始化列表与强制转换.
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false
SpaceAfterCStyleCast: false

# 指针右对齐.
PointerAlignment: Right
DerivePointerAlignment: false

# 预处理指令顶格, 与 AGENTS.md 第 7.6 节的示例一致.
IndentPPDirectives: None

# 不自动重排 include, 保持 AGENTS.md 第 2 节规定的包含顺序.
SortIncludes: false
IncludeBlocks: Preserve

# 不重排注释, 避免破坏中文注释的排版.
ReflowComments: false

# 行尾注释对齐, 与 AGENTS.md 第 8.3 节的示例一致.
AlignTrailingComments: true

# 连续赋值与宏按块对齐, 与 AGENTS.md 第 4.1, 4.2 节的表格一致.
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveMacros: Consecutive
AlignConsecutiveDeclarations: false

# 行宽.
ColumnLimit: 100

# 续行反斜杠紧跟内容, 不顶到行宽边界.
AlignEscapedNewlines: Left

# 其他.
IndentCaseLabels: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SpacesBeforeTrailingComments: 1
SpacesInParentheses: false
SpacesInSquareBrackets: false
